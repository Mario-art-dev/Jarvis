PORT=8787
# Token secreto que también pegarás en Ajustes de la app Jarvis (campo "Server Token").
# Genera uno con: openssl rand -hex 32
JARVIS_SERVER_TOKEN=cambia-esto-por-algo-secreto

# Opcional, SOLO si tu Mac no puede actualizarse a macOS 13+ (ej. Big Sur en un
# iMac antiguo): el paquete claude-agent-sdk trae su propio ejecutable "claude"
# compilado, que requiere macOS 13+ y falla con un error "dyld: Symbol not
# found" en versiones más antiguas. Esta variable le dice al SDK que use en su
# lugar el ejecutable de un @anthropic-ai/claude-code antiguo (instalado con
# `npm install -g @anthropic-ai/claude-code@2.1.112`), que sí es compatible.
# Más fácil: ejecuta server/scripts/fix-legacy-claude-code.sh, que instala esa
# versión y rellena estas dos variables automáticamente (ver README).
# CLAUDE_CODE_EXECUTABLE_PATH=/ruta/que/te/de/npm/root -g/@anthropic-ai/claude-code/cli.js
#
# Imprescindible junto con la anterior: Claude Code se autoactualiza solo en
# cuanto se ejecuta una vez (ej. `claude login`), lo que trae de vuelta una
# versión nueva con el binario nativo incompatible y deshace el arreglo de
# arriba. Esta variable se lo impide para siempre.
# DISABLE_AUTOUPDATER=1

# Opcional: voz local con Piper (gratis, ilimitada, sin internet ni cuenta).
# No las pongas a mano — ejecuta server/scripts/install-piper.sh, que descarga
# Piper y una voz en español, comprueba que arranca en tu Mac y rellena estas
# dos líneas solo. Si no están, Jarvis usa ElevenLabs (y la voz del iPhone si
# se agotan los créditos), que es el comportamiento por defecto.
# PIPER_PATH=/ruta/a/Jarvis/server/piper/piper/piper
# PIPER_VOICE=/ruta/a/Jarvis/server/piper/es_ES-davefx-medium.onnx

# Opcional: para que Jarvis pueda leer tu Gmail (correos sin leer, remitente, asunto).
# 1. Activa la verificación en dos pasos en tu cuenta de Google, si no la tienes ya.
# 2. Ve a https://myaccount.google.com/apppasswords y genera una contraseña de aplicación
#    (nombre: lo que quieras, ej. "Jarvis").
# 3. Rellena una cuenta aquí abajo (LABEL es solo para que puedas decirle "el gmail de
#    trabajo" por voz — pon lo que quieras, ej. personal / trabajo).
# Puedes añadir una segunda cuenta duplicando el bloque con _2 en vez de _1 (hasta _9).
# Si dejas esto vacío, la herramienta de Gmail simplemente avisa que no está configurada.
GMAIL_1_LABEL=personal
GMAIL_1_ADDRESS=
GMAIL_1_APP_PASSWORD=

# GMAIL_2_LABEL=trabajo
# GMAIL_2_ADDRESS=
# GMAIL_2_APP_PASSWORD=
